# Pretrained weights are downloaded on first run - never commit.
weights/
# Ultralytics default output folder (not used by our scripts, but just in case).
runs/
# Fine-tuning dataset generated by prepare_finetune_data.py (thousands of images).
data/
# Trained weights (~20 MB each). The rest of training_runs/<name>/ (training_info.json,
# results.csv, args.yaml, plots) is small and can be committed as the training record.
training_runs/*/weights/
# Mosaics of dataset photos generated during training - not needed as a record.
training_runs/*/train_batch*.jpg
training_runs/*/val_batch*.jpg
training_runs/*/labels.jpg
